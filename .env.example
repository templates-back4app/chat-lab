# Copy to .env and fill in. Never commit .env. Scripts never print these values.
#
# Phase A runs everything locally: `npm run dev:server` starts a parse-server with FIXED local keys
# (scripts/lib/env.mjs LOCAL — they are not secrets, the server only listens on localhost and the database is a
# throwaway), so an empty .env is fine for local work. These variables are only read when the scripts and tests
# are later pointed at a Back4app backend (the live phase — do not run it from this repo until the coordinator
# says so).
#
# Back4app → your backend app → App Settings → Security & Keys.
# MASTER_KEY is OPTIONAL even then: everything privileged goes through the setup-gated Cloud functions
# (setupSchema, testInspect, testCleanup, testSeedMessages), which additionally require SETUP_TOKEN below.
APP_ID=
JS_KEY=
REST_KEY=
MASTER_KEY=
SERVER_URL=https://parseapi.back4app.com

# LiveQuery host of the live backend (dashboard: App Settings → Server Settings → Live Query; enable Message).
# LIVEQUERY_URL=wss://<subdomain>.b4a.io

# The administrative setup token (amendment B5): the raw token the operator generated. Its SHA-256 hex must be
# configured server-side (cloud/config.js reads SETUP_TOKEN_SHA256 from the Cloud Code environment, or edit the
# fallback constant before upload). Without BOTH the flag and the matching token, setupSchema/testInspect/
# testCleanup/testSeedMessages refuse. The default deployment ships with both unset: helpers disabled.
# SETUP_TOKEN=

# Local development only: Postgres database used by the local parse-server (port 5433, brew postgresql@17 —
# the same instance tenant-lab uses; distinct database names chat_dev / chat_test).
DATABASE_URL=postgres://localhost:5433/chat_dev

# Point the test suite at another server (e.g. the live backend, later) instead of the in-process local one.
# TEST_SERVER_URL=https://parseapi.back4app.com
